        "import torch\n",
        "import pandas as pd\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.linear_model import LinearRegression\n",
        "from sklearn.metrics import r2_score\n"
      ],
      "metadata": {
        "id": "0gAW-zAlH4V7"
      },
      "execution_count": 1,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "r_val = 30000.1\n",
        "r_s_val = 0.00887\n",
        "\n",
        "r = torch.tensor(r_val, dtype=torch.float64, requires_grad=True)  #Make r a tensor with autograd feature\n",
        "r_s = torch.tensor(r_s_val, dtype=torch.float64)\n",
        "\n",
        "tau = 2 * 4 * torch.sqrt(r/r_s) * torch.sqrt(1-(r_s/r)) #Calculate tau\n",
        "tau.backward()  #Use backwards propagation to find derivative of tau\n",
        "d_tau_dr = r.grad.item()  #Extract the value of the derivative from inside r.grad\n",
        "\n",
        "print(f\"tau: {tau.item()}\")\n",
        "print(f\"d_tau_dr at r = {r_val}: {d_tau_dr}\")"
      ],
